# {{project_name}} — example environment. Copy to `.env` (git-ignored) for
# local runs; production sets real values through its own secret store.
#
# Keys under SEKVENT_ are reserved for the framework: an unknown SEKVENT_* key
# is a startup error, so a typo does not silently fall back to a default.

# Log filter directives (falls back to RUST_LOG, then `info`).
SEKVENT_LOG=info,{{crate_ident}}=debug
# compact | pretty | json
SEKVENT_LOG_FORMAT=pretty

# Service settings. Every key is read by the crate's `Config`
# (`#[derive(EnvConfig)]`); missing required keys are reported all at once,
# by name, never by value.
LISTEN_ADDR=127.0.0.1:8080
SHUTDOWN_DELAY=0s

# Service-to-service tokens (sekvent-link), one per link: canonical
# [A-Za-z0-9_-] strings of at least `sekvent::link::MIN_TOKEN_LEN` characters,
# e.g. from `sekvent::link::random_token()`.
# SEKVENT_LINK_INBOUND_BILLING=
# SEKVENT_LINK_OUTBOUND_BILLING=
# SEKVENT_LINK_TRUSTED=billing

# Test harness: run the Docker-backed tests (`#[ignore]`d otherwise).
# SEKVENT_DOCKER_TESTS=1
