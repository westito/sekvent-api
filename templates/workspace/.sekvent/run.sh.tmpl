#!/usr/bin/env bash
# Run `cargo sekvent <args>` with the CLI built from the exact sekvent
# revision this project is locked to.
#
# Used inside the remote builder container (`rrb run sekvent <args>`) and in
# CI, where cargo-sekvent runs its commands locally. The revision comes from
# Cargo.lock, so the CLI and the libraries can never disagree.
#
# Each revision is installed into its own root,
# $CARGO_HOME/sekvent-cli/<rev>, and that binary is executed directly, never
# looked up on PATH. A root is written once and never changed afterwards, so
# `cargo sekvent self-update`, install.sh or another project sharing
# CARGO_HOME cannot swap the CLI underneath this one. The binary is built in
# a temporary root and renamed into place, so concurrent runs are safe.
#
# A project that depends on sekvent by path (framework development) has no
# git revision; set SEKVENT_SRC to the sekvent checkout instead. That CLI
# lives in $CARGO_HOME/sekvent-cli/path-<hash of SEKVENT_SRC> and is rebuilt
# on every run, since the checkout can change at any time (cargo reuses the
# build in $CARGO_TARGET_DIR/sekvent-cli, so an unchanged tree is quick).
set -euo pipefail

cd "$(dirname "$0")/.."

git_url="{{sekvent_git_url}}"
export CARGO_HOME="${CARGO_HOME:-$HOME/.cargo}"
export PATH="$CARGO_HOME/bin:$PATH"
cli_home="$CARGO_HOME/sekvent-cli"

# install_cli ROOT CARGO_INSTALL_ARGS...: build cargo-sekvent into a fresh
# temporary root and rename the binary to ROOT/bin/cargo-sekvent. rename(2)
# replaces the file atomically; a process already running the old file keeps
# it.
install_cli() {
  local root="$1"
  shift
  mkdir -p "$cli_home" "$root/bin"
  local tmp
  tmp="$(mktemp -d "$cli_home/.install.XXXXXX")"
  if ! cargo install --locked --root "$tmp" "$@"; then
    rm -rf "$tmp"
    echo "error: installing cargo-sekvent failed" >&2
    exit 1
  fi
  mv -f "$tmp/bin/cargo-sekvent" "$root/bin/cargo-sekvent"
  rm -rf "$tmp"
}

if [[ ! -f Cargo.lock ]]; then
  echo "error: Cargo.lock is missing; run \`cargo generate-lockfile\` and commit it" >&2
  exit 1
fi

# The `source` line of the `sekvent` package, e.g.
#   source = "git+https://github.com/westito/sekvent?branch=master#0123abcd…"
source_line="$(awk '
  /^\[\[package\]\]/ { in_sekvent = 0; next }
  /^name = "sekvent"$/ { in_sekvent = 1; next }
  in_sekvent && /^source = / { print; exit }
' Cargo.lock)"

if [[ -n "$source_line" ]]; then
  source="${source_line#source = \"}"
  source="${source%\"}"
  case "$source" in
    "git+${git_url}"*"#"*) ;;
    *)
      echo "error: sekvent in Cargo.lock comes from an unexpected source: $source" >&2
      echo "       expected git+${git_url}" >&2
      exit 1
      ;;
  esac
  rev="${source##*#}"
  if [[ ! "$rev" =~ ^[0-9a-f]{40}([0-9a-f]{24})?$ ]]; then
    echo "error: sekvent in Cargo.lock has no full commit id: $source" >&2
    exit 1
  fi
  root="$cli_home/$rev"
  if [[ ! -x "$root/bin/cargo-sekvent" ]]; then
    echo "installing cargo-sekvent at ${rev:0:12} into $root" >&2
    install_cli "$root" --git "$git_url" --rev "$rev" cargo-sekvent
  fi
elif grep -q '^name = "sekvent"$' Cargo.lock; then
  # A path dependency: no source line, no revision to pin.
  if [[ -z "${SEKVENT_SRC:-}" ]]; then
    echo "error: sekvent is a path dependency, so there is no git revision to install" >&2
    echo "       the CLI from; set SEKVENT_SRC to the sekvent checkout" >&2
    exit 1
  fi
  src="$(cd "$SEKVENT_SRC" && pwd -P)"
  key="$(printf '%s' "$src" | cksum | awk '{ print $1 }')"
  root="$cli_home/path-$key"
  echo "installing cargo-sekvent from $src into $root" >&2
  install_cli "$root" --path "$src/crates/cargo-sekvent" \
    --target-dir "${CARGO_TARGET_DIR:-$PWD/target}/sekvent-cli"
else
  echo "error: Cargo.lock has no sekvent package; is sekvent in [workspace.dependencies]?" >&2
  exit 1
fi

exec "$root/bin/cargo-sekvent" sekvent "$@"
